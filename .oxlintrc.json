{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    "packages/*/dist/**",
    "examples/*/dist/**"
  ],
  "rules": {
    "no-debugger": "error",
    "no-console": "off"
  }
}
