    "/a\nb",
    "C:",
    "C:x",
    "C:/x",
    "C:\\x\\",
    "C:\\x\\\\y",
    "C:\\x\\..\\y",
    "C:\\x\\.",
    "C:\\x:y",
    "C:\\x:stream\\y",
    "C:\\x/y",
    "\\\\server\\share",
    "\\\\?\\C:\\x",
    "\\\\.\\COM1",
