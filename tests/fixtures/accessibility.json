{
  "capabilities": ["split_resize_v1", "accessibility_v1"],
  "scope": "Shared accessible_label element validation; not native GUI evidence.",
  "cases": [
    {
      "name": "dialog-label",
      "element": {
        "kind": "overlay",
        "modal": true,
        "accessible_label": "Rename file"
      },
      "expected": {
        "kind": "overlay",
        "anchor": "window",
        "modal": true,
        "accessible_label": "Rename file",
        "style": {}
      }
    },
    {
      "name": "parent-overlay-label",
      "element": {
        "kind": "overlay",
        "anchor": "parent",
        "accessible_label": "Actions"
      },
      "expected": {
        "kind": "overlay",
        "anchor": "parent",
        "modal": false,
        "accessible_label": "Actions",
        "style": {}
      }
    },
    {
      "name": "split-label",
      "element": {
        "kind": "split",
        "accessible_label": "Sidebar"
      },
      "expected": {
        "kind": "split",
        "ratio": 0.5,
        "min_size": 0,
        "accessible_label": "Sidebar",
        "style": {}
      }
    },
    {
      "name": "empty-label",
      "element": {
        "kind": "split",
        "accessible_label": ""
      },
      "expected": {
        "kind": "split",
        "ratio": 0.5,
        "min_size": 0,
        "accessible_label": "",
        "style": {}
      }
    },
    {
      "name": "unicode-label",
      "element": {
        "kind": "overlay",
        "accessible_label": "שלום 👋"
      },
      "expected": {
        "kind": "overlay",
        "anchor": "window",
        "modal": false,
        "accessible_label": "שלום 👋",
        "style": {}
      }
    },
    {
      "name": "label-null",
      "element": {
        "kind": "split",
        "accessible_label": null
      }
    },
    {
      "name": "label-number",
      "element": {
        "kind": "overlay",
        "accessible_label": 3
      }
    },
    {
      "name": "label-nul",
      "element": {
        "kind": "overlay",
        "accessible_label": "a\u0000b"
      }
    },
    {
      "name": "label-too-long",
      "element": {
        "kind": "split",
        "accessible_label": ""
      }
    },
    {
      "name": "box-label",
      "element": {
        "kind": "box",
        "accessible_label": "Group"
      }
    },
    {
      "name": "text-label",
      "element": {
        "kind": "text",
        "text": "a",
        "accessible_label": "b"
      }
    },
    {
      "name": "button-label",
      "element": {
        "kind": "button",
        "text": "a",
        "accessible_label": "b"
      }
    },
    {
      "name": "input-label",
      "element": {
        "kind": "input",
        "value": "",
        "accessible_label": "b"
      }
    }
  ]
}
