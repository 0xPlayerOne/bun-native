<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Bun executables (the AOT application, the
  compiled updater and the verifying launcher). JavaScriptCore maps executable
  memory, which the hardened runtime refuses without these. The GPUI host is
  signed with the hardened runtime and no entitlements. See docs/releasing.md.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
