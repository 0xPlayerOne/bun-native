{
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "ignorePatterns": [
    "CHANGELOG.md",
    ".github/.code-foundry",
    ".github/actions/",
    "node_modules/**",
    "native/target/**",
    "dist/**",
    ".bun-native/**"
  ],
  "tabWidth": 2,
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off"
}
