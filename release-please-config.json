{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "refactor",
      "section": "Maintenance"
    },
    {
      "type": "chore",
      "section": "Maintenance"
    }
  ],
  "pull-request-title-pattern": "chore(main): release ${version}",
  "group-pull-request-title-pattern": "chore(main): release ${version}",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "bunly-monorepo",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "packages/artifacts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/cli/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/contracts/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/runtime/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "packages/runtime/src/cef.ts"
        },
        {
          "type": "generic",
          "path": "packages/runtime/src/mock.ts"
        }
      ],
      "initial-version": "0.1.0"
    }
  }
}
