+/// Bun Native patch: set once a process must not pace windows with
+/// `CAMetalDisplayLink` (see [`disable_metal_display_link`]).
+static METAL_DISPLAY_LINK_DISABLED: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+/// Bun Native patch: pace every window opened after this call with the shared
+/// `CVDisplayLink` registry and draw into `nextDrawable`, the path this crate
+/// already takes where `CAMetalDisplayLink` is unavailable (before macOS 14).
+/// Windows already open keep their frame source.
+pub fn disable_metal_display_link() {
+    METAL_DISPLAY_LINK_DISABLED.store(true, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Whether a window opened now is paced by a `CAMetalDisplayLink`.
+pub(crate) fn metal_display_link_enabled() -> bool {
+    MetalFrameSource::is_available()
+        && !METAL_DISPLAY_LINK_DISABLED.load(std::sync::atomic::Ordering::Relaxed)
+}
