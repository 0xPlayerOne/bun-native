+// Own each successful initialization until construction transfers its resources
+// into Inner. A failed attempt must not retain a reference to a shared display.
+struct ContextInitialization<'a> {
+    egl: &'a EglInstance,
+    display: Option<khronos_egl::Display>,
+    context: Option<khronos_egl::Context>,
+}
+
+impl Drop for ContextInitialization<'_> {
+    fn drop(&mut self) {
+        let Some(display) = self.display else {
+            return;
+        };
+        if let Some(context) = self.context {
+            if let Err(e) = self.egl.destroy_context(display, context) {
+                log::warn!("Error in destroy_context: {e:?}");
+            }
+        }
+        if let Err(e) = terminate_display(self.egl, display) {
+            log::warn!("Error in terminate: {e:?}");
+        }
+    }
+}
