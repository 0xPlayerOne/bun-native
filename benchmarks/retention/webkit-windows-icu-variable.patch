--- a/build-icu.ps1
+++ b/build-icu.ps1
@@ -79,7 +79,7 @@
 if (Test-Path $ICU_SOURCE_DIR) {
     $have = if (Test-Path $ICU_SOURCE_STAMP) { (Get-Content $ICU_SOURCE_STAMP -Raw).Trim() } else { "" }
     if ($have -ne $ICU_VERSION) {
-        Write-Host ":: $ICU_SOURCE_DIR is ICU '$have', not $ICU_VERSION: removing it"
+        Write-Host ":: $ICU_SOURCE_DIR is ICU '$have', not ${ICU_VERSION}: removing it"
         Remove-Item -Recurse -Force $ICU_SOURCE_DIR
     }
 }
@@ -100,7 +100,12 @@
     Write-Host ":: Extracting ICU"
     # ICU tarball extracts to icu/ directory
     $extractDir = Split-Path -Parent $OutputDir
-    tar.exe -xzf $ICU_TARBALL -C $extractDir
+    # The diagnostic build maps the Bun source to X:; use the physical path for system tar.
+    $mappedRoot = [System.IO.Path]::GetPathRoot($OutputDir)
+    if ($mappedRoot -ne "X:\" -or -not $env:BUN_NATIVE_SOURCE_ROOT) { throw "Expected diagnostic source mapping" }
+    $physicalArchive = Join-Path $env:BUN_NATIVE_SOURCE_ROOT ($ICU_TARBALL.Substring($mappedRoot.Length))
+    $physicalExtractDir = Join-Path $env:BUN_NATIVE_SOURCE_ROOT ($extractDir.Substring($mappedRoot.Length))
+    & (Join-Path $env:SystemRoot "System32/tar.exe") -xzf $physicalArchive -C $physicalExtractDir
     if ($LASTEXITCODE -ne 0) { throw "tar failed with exit code $LASTEXITCODE" }
     # The patch has to stay a plain diff: in a directory of a repository, git apply skips a "diff --git" one and exits with 0.
     git -C $OutputDir apply --ignore-whitespace (Join-Path $PSScriptRoot "icu/decnum-allocation-failure.patch")
