+#[derive(Clone, Copy)]
+enum HitboxOrder {
+    BeforeChildren,
+    AfterChildren,
+}
+
+/// The parts of an element's style that clip its own GPUI hitbox: overflow,
+/// and a visible border inside an overflow clip. `None` when nothing clips.
+pub(super) struct Clip(Option<Style>);
+
+impl Clip {
+    pub(super) fn of(style: &StyleRefinement) -> Self {
+        let overflow = Point::<Overflow>::default().refined(style.overflow.clone());
+        if overflow.x == Overflow::Visible && overflow.y == Overflow::Visible {
+            return Self(None);
+        }
+        let mut clip = Style {
+            overflow,
+            border_color: style.border_color,
+            ..Style::default()
+        };
+        clip.border_widths.refine(&style.border_widths);
+        Self(Some(clip))
+    }
+
+    fn mask(&self, bounds: Bounds<Pixels>, window: &Window) -> Option<ContentMask<Pixels>> {
+        self.0
+            .as_ref()
+            .and_then(|style| style.overflow_mask(bounds, window.rem_size()))
+    }
+}
+
+/// A transparent wrapper that gives one model element its pointer hitbox. It
+/// shares the element's layout node, so its bounds are the element's bounds.
+struct PointerTarget {
+    child: AnyElement,
+    node_id: NodeId,
+    clip: Clip,
+    order: HitboxOrder,
+    frame: PointerFrame,
+}
+
+impl PointerTarget {
+    fn insert(&self, bounds: Bounds<Pixels>, window: &mut Window) -> HitboxId {
+        let mask = self.clip.mask(bounds, window);
+        window
+            .with_content_mask(mask, |window| {
+                window.insert_hitbox(bounds, HitboxBehavior::Normal)
+            })
+            .id
+    }
+}
+
+impl IntoElement for PointerTarget {
+    type Element = Self;
+
+    fn into_element(self) -> Self {
+        self
+    }
+}
+
+impl Element for PointerTarget {
+    type RequestLayoutState = ();
+    type PrepaintState = HitboxId;
+
+    fn id(&self) -> Option<ElementId> {
+        None
+    }
+
+    fn source_location(&self) -> Option<&'static Location<'static>> {
+        None
+    }
+
+    fn request_layout(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> (LayoutId, ()) {
+        (self.child.request_layout(window, cx), ())
+    }
+
+    fn prepaint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        bounds: Bounds<Pixels>,
+        _: &mut (),
+        window: &mut Window,
+        cx: &mut App,
+    ) -> HitboxId {
+        match self.order {
+            HitboxOrder::BeforeChildren => {
+                let hitbox = self.insert(bounds, window);
+                self.child.prepaint(window, cx);
+                hitbox
+            }
+            HitboxOrder::AfterChildren => {
+                self.child.prepaint(window, cx);
+                self.insert(bounds, window)
+            }
+        }
+    }
+
+    fn paint(
+        &mut self,
+        _: Option<&GlobalElementId>,
+        _: Option<&InspectorElementId>,
+        _: Bounds<Pixels>,
+        _: &mut (),
+        hitbox: &mut HitboxId,
+        window: &mut Window,
+        cx: &mut App,
+    ) {
+        // Registered where the element's own capture listeners were: in paint
+        // order, ahead of its children.
+        self.frame.0.borrow_mut().push((*hitbox, self.node_id));
+        self.child.paint(window, cx);
+    }
+}
