+/// An empty leaf needs no allocation. Once written, lists remain persistent.
+#[derive(Debug, Clone, Default)]
+struct Children(Option<Arc<Vec<NodeId>>>);
+
+impl Deref for Children {
+    type Target = [NodeId];
+    fn deref(&self) -> &Self::Target {
+        self.0.as_deref().map_or(&[], Vec::as_slice)
+    }
+}
+impl PartialEq for Children {
+    fn eq(&self, other: &Self) -> bool {
+        self.deref() == other.deref()
+    }
+}
+impl Children {
+    fn make_mut(&mut self) -> &mut Vec<NodeId> {
+        Arc::make_mut(self.0.get_or_insert_with(Arc::default))
+    }
+    fn shares_storage(&self, other: &Self) -> bool {
+        match (&self.0, &other.0) {
+            (None, None) => true,
+            (Some(left), Some(right)) => Arc::ptr_eq(left, right),
+            _ => false,
+        }
+    }
+}
